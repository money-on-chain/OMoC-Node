# Don't commit this to source control.
# Eg. Include ".env" in your `.gitignore` file.

# The following parameters are mandatory, the rest are optional (see README.md)
# The server starts with reasonable defaults and then gets the parameters from the blockchain.
# The server expect to find in "build/contracts" the files with the abis and addresses of contracts

# Contracts ABI folder location
CONTRACT_ROOT_FOLDER=../contracts/

# Ganache cli
# NODE_URL="http://localhost:8545"
# CHAIN_ID=1

# RSK testnet
NODE_URL="https://public-node.testnet.rsk.co:443"
CHAIN_ID=31

# Oracle-only parameters.
# Account used to publish prices
ORACLE_PRIVATE_KEY="0x... PUT YOUR PRIVATE KEY HERE"

ORACLE_COIN_PAIR_FILTER=["BTCUSD"]

# Updated nodes always publish prices using V4. TasksRunner stays on V3.
TASK_MESSAGE_VERSION=3
# Emergency-only: the address below is ignored by default when it is the only
# available task. Override with comma-separated addresses, or set to empty to disable.
# IGNORE_POSSIBLY_STUCK_TASKS=0x40652119dfC7a114c43D36bd5369400577803E91
PRICE_SIGNATURE_EXPIRATION_SECONDS="5 mins"
PRICE_SIGNATURE_MIN_VALIDITY_SECONDS="30 secs"
PRICE_SIGNATURE_MAX_VALIDITY_SECONDS="10 mins"

REGISTRY_ADDR=0x
